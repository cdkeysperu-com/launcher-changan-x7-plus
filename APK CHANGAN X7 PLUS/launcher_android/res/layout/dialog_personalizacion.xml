<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E605080E"
    android:padding="20dp">

    <!-- CABECERA -->
    <RelativeLayout
        android:id="@+id/header_personalizacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CENTRO DE PERSONALIZACIÓN COCKPIT X7 PLUS"
                android:textColor="#00F0FF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Elige tu fondo de pantalla favorito, gestiona videos de bienvenida y opciones de inicio"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_personalizacion"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:background="@drawable/bg_circle_btn"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar" />
    </RelativeLayout>

    <!-- CONTENIDO CON SCROLL HORIZONTAL / VERTICAL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_personalizacion"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECCIÓN 1: FONDOS DE PANTALLA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼️ FONDOS DE PANTALLA PANORÁMICOS (1920x720)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="10dp">

                <!-- TEMA 1: SUV ORIGINAL -->
                <LinearLayout
                    android:id="@+id/card_theme_suv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_cockpit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Oshan X7 Luxury SUV"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- TEMA 2: CYBER NEON -->
                <LinearLayout
                    android:id="@+id/card_theme_neon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_wallpaper_neon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Cyber Neon Cockpit"
                        android:textColor="#00F0FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- TEMA 3: MIDNIGHT STEALTH -->
                <LinearLayout
                    android:id="@+id/card_theme_minimal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_wallpaper_minimal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Midnight Obsidian"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- TEMA 4: SUNSET GT -->
                <LinearLayout
                    android:id="@+id/card_theme_sunset"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_wallpaper_sunset" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Sunset Horizon GT"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- BOTONES DE CARGA PERSONALIZADA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <Button
                    android:id="@+id/btn_pick_custom_wallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="📁 Cargar Imagen desde Almacenamiento / USB"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_scan_wallpapers_folder"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="🔍 Explorar /sdcard/Changan/Wallpapers/"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginBottom="14dp" />

            <!-- SECCIÓN 2: VIDEO DE INICIO / BIENVENIDA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 VIDEO DE INICIO / BIENVENIDA (REEMPLAZA 'HELLO')"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_video_folder_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Puedes colocar múltiples videos MP4 en: /sdcard/Changan/Videos/ y se reproducirán aleatoriamente al encender la pantalla."
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <Button
                    android:id="@+id/btn_toggle_video_always"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_side_home_active"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="⚡ Siempre en Cada Inicio"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_toggle_video_cooldown"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="❄️ Solo Inicio en Frío (30 min)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_toggle_video_random"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="🎲 Modo Aleatorio: ACTIVADO"
                    android:textColor="#00F0FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_test_play_video"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="▶️ Probar Video Ahora"
                    android:textColor="#22C55E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginBottom="14dp" />

            <!-- SECCIÓN 3: ACCESO DIRECTO A LAUNCHER ONSTYLE Y AJUSTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏢 LAUNCHER ONSTYLE DE FÁBRICA Y AJUSTES CHANGAN"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_switch_to_onstyle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="🏢 Volver a Launcher OnStyle Original"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_open_ygps_monitor"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="🛰️ Abrir Monitor Satelital MediaTek YGPS"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_open_car_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="⚙️ Ajustes del Vehículo"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- FILA 2: AJUSTES ANDROID / TELÉFONO & BURBUJA FLOTANTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_open_phone_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_sidebar_btn"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="📱 Ajustes del Teléfono / Android"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_toggle_floating_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_side_home_active"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="🔘 Burbuja Flotante Retroceso (Mostrar)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
