<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000"
    android:gravity="center">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_glass"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fav_headunit"
                    android:contentDescription="Android Auto" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="ASISTENTE DE CONEXIÓN ANDROID AUTO / HEADUNIT"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close_headunit_dlg"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#20FFFFFF" />

        <!-- Info IP del vehículo -->
        <TextView
            android:id="@+id/tv_hu_current_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP Local del Auto: Detectando red..."
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Escenario 1: Hotspot directo del móvil -->
        <LinearLayout
            android:id="@+id/btn_hu_mode_hotspot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_fav_item"
            android:orientation="vertical"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Celular comparte Wi-Fi al Auto (Hotspot Directo)"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Conexión instantánea al Gateway (192.168.43.1). Toca para conectar."
                android:textColor="#C5CED8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Escenario 2: Red Compartida (3er móvil como router) -->
        <LinearLayout
            android:id="@+id/btn_hu_mode_shared_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_fav_item"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Red Compartida (2do Celular / Módem como Router)"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Auto y celular principal conectados al mismo router. Ingresa la IP del celular:"
                android:textColor="#C5CED8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_phone_ip"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="#20FFFFFF"
                    android:hint="Ej: 192.168.43.25"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#60FFFFFF"
                    android:textSize="12sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_connect_custom_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_btn_configure"
                    android:text="Conectar"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_scan_subnet_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_btn_configure"
                    android:text="🔍 Auto"
                    android:textColor="#00E5FF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Escenario 3: Cable USB & Autónomo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_hu_mode_usb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_fav_item"
                android:text="🔌 Cable USB Directo"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_hu_mode_standalone"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_fav_item"
                android:text="📱 Modo Autónomo"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
