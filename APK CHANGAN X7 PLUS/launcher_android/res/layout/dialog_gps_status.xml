<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000"
    android:gravity="center">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_glass"
        android:padding="22dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dlg_dot_gps"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_gps_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="SUBSISTEMA DE LOCALIZACIÓN GPS SATELITAL"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close_gps_dlg"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentRight="true"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#20FFFFFF" />

        <!-- Status Details -->
        <TextView
            android:id="@+id/tv_dlg_gps_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo Actual: GPS Nativo del Vehículo Activo"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dlg_gps_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Últimas coordenadas: Esperando satélites..."
            android:textColor="#C5CED8"
            android:textSize="12sp" />

        <!-- Selector de Modo de Operación GPS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SELECCIONAR FUENTE DE UBICACIÓN:"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_mode_gps_native"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_badge_connected"
                android:text="🛰️ GPS Nativo del Auto"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mode_gps_mock"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_fav_item"
                android:text="📱 GPS Compartido (Móvil)"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Help Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_fav_item"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Recomendación para Waze y Google Maps"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_gps_help_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• GPS Nativo: Utiliza el receptor satelital físico de la Changan sin intermediarios.\n• Android Auto: Al conectar Headunit, Waze usa directamente el GPS de tu móvil con máxima precisión."
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="right"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset_gps_native"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_configure"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="🔄 Restablecer GPS AOSP"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
