<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9060B14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_music_widget"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROL RÁPIDO CHANGAN X7 PLUS"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_ctrl_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentRight="true"
                android:background="@drawable/bg_fav_pill"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:contentDescription="Cerrar" />
        </RelativeLayout>

        <!-- Section 1: Modos de Manejo & EPS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODO DE CONDUCCIÓN &amp; DIRECCIÓN EPS"
            android:textColor="#8FA0B5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_mode_eco"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_fav_pill"
                android:text="🌱 ECO"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mode_comfort"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_fav_pill"
                android:text="✨ CONFORT"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mode_sport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_fav_pill"
                android:text="⚡ SPORT"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section 2: Acciones Rápidas del Vehículo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HERRAMIENTAS &amp; SISTEMA OEM"
            android:textColor="#8FA0B5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/btn_ctrl_camera360"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_fav_pill"
                android:text="📷 Cámara 360° AVM"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_ctrl_night_mode"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_fav_pill"
                android:text="🌙 Modo Nocturno (Apagar Pantalla)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_ctrl_eq"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_fav_pill"
                android:text="🎛️ Sonido &amp; Ecualizador"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btn_ctrl_factory_launcher"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_fav_pill"
                android:text="🔄 Volver a OnStyle Original"
                android:textColor="#FACC15"
                android:textStyle="bold" />
        </GridLayout>

    </LinearLayout>
</LinearLayout>
